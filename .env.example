# Copiar a .env y ajustar si hace falta. Valores solo para desarrollo local.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=tuhorario
POSTGRES_PASSWORD=tuhorario
POSTGRES_DB=tuhorario

# Backend (FastAPI)
DATABASE_URL=postgresql+psycopg://tuhorario:tuhorario@localhost:5432/tuhorario
# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
